# Copia este archivo a .env y completa. NUNCA subas .env al repositorio.
DATABASE_HOST=localhost
DATABASE_PORT=3306
DATABASE_NAME=trazabilidad
DATABASE_USER=
DATABASE_PASSWORD=

# Secretos (genera cadenas largas aleatorias: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
RETIRO_HMAC_SECRET=cambia-esto
CRON_SECRET=cambia-esto

# Contrasena inicial de los 4 usuarios de demo (la usa npm run seed:usuarios)
DEMO_PASSWORD=Demo2026!

# Pon true cuando uses HTTPS (produccion)
COOKIE_SECURE=false

# Mensajes: 'simulado' (no envia nada, se ve en la pantalla Mensajes) o 'evolution'
MENSAJES_PROVEEDOR=simulado
EVOLUTION_URL=
EVOLUTION_INSTANCE=
EVOLUTION_API_KEY=
EVOLUTION_API_VERSION=v2
# Solo para evolution: numeros de prueba separados por coma (formato 5939XXXXXXXX)
MENSAJES_NUMEROS_PERMITIDOS=
